{
  "name": "email-confirm-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "browser": { "binding": "BROWSER" },
  "kv_namespaces": [
    { "binding": "CONFIRM_LOG", "id": "3a25131c91584f47bb207909370f7f0c" }
  ],
  "vars": {
    "FORWARD_TO": "1041159627@qq.com",
    "ALLOWED_SENDERS": "openai.com,google.com",
    "DRY_RUN": "true",
    "USE_BROWSER": "true"
  }
}
